# Fournir votre véritable domaine public HTTPS pour npm run build.
# Aucun domaine réel n'est présumé ici. npm run build:android fonctionne sans domaine public.
# SITE_URL=https://votre-domaine.fr

# Serveur Vercel uniquement, jamais NEXT_PUBLIC_ :
# RESEND_API_KEY=...
# RESEND_FROM_EMAIL=adresse-expedition-verifiee@votre-domaine.fr

# Build Android : origine HTTPS du même déploiement Vercel (sans chemin).
# Web utilise toujours /api/submit-example sur son origine courante.
# NEXT_PUBLIC_SUBMISSION_ORIGIN=https://votre-domaine.fr
